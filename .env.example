# Bybit API credentials created specifically for Demo Trading.
BYBIT_API_KEY="YOUR_BYBIT_API_KEY"
BYBIT_API_SECRET="YOUR_BYBIT_API_SECRET"
BYBIT_DEMO="true"

# Protects endpoints which can start/stop the bot or submit orders.
# Generate a long, random value and do not commit the real value.
APP_SECRET="GENERATE_A_LONG_RANDOM_SECRET"

# Optional: a PostgreSQL/Neon connection string for persistent settings and trade history.
# Without it, the existing in-memory fallback will be used.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"
